# Lokrakshak Real Property Center - Apache Security + Clean SEO URLs
Options -Indexes
RewriteEngine On

# Force clean URLs: /contact.php -> /contact
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Internally load PHP files without showing .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Homepage fallback
DirectoryIndex index.php

# Protect sensitive project files
<FilesMatch "^(config\.php|setup_database\.sql|README.*\.md)$">
    Require all denied
</FilesMatch>

# Basic security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Block common bad bots/scanners
SetEnvIfNoCase User-Agent "sqlmap|nikto|nmap|masscan|acunetix|wpscan" bad_bot
<RequireAll>
    Require all granted
    Require not env bad_bot
</RequireAll>
